PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://localhost:27017/mock_interviewer
# Use a long random string (e.g. `openssl rand -hex 32`). Required in production.
JWT_SECRET=your_jwt_secret_here
# Comma-separated list of allowed frontend origins for CORS.
CORS_ORIGIN=http://localhost:5173
GEMINI_API_KEY=your_gemini_api_key_here
AI_SERVICE_URL=http://localhost:8000
# Real-time transcription: if set, uses Deepgram (primary). If empty, falls back
# to the local Whisper service at AI_SERVICE_URL. Get a key at https://deepgram.com
DEEPGRAM_API_KEY=your_key
DEEPGRAM_MODEL=nova-3
